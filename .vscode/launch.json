{
    // Rdebug is typically for Ruby, but you probably mean running gdb with a C++ project on Ubuntu.
    // For native C++ debugging in VSCode on Ubuntu, this config is good.
    // Minor improvements made below for clarity and Ubuntu defaults.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug postgres Example",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/example/postgres_armory_example",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/build/example",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb", // gdb is the default debugger on Ubuntu for C/C++
            "miDebuggerPath": "/usr/bin/gdb", // explicitly set for Ubuntu, optional but clear
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
            // Optional: Uncomment if you want specific source file mappings or symbol loading:
            // "symbolLoadInfo": {
            //     "loadAll": true,
            //     "exceptionList": []
            // }
        }
    ]
}